{
  "name": "narratio",
  "version": "1.0.0",
  "description": "Self-hosted RSS-to-podcast with AI-generated audio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc && cp -r src/server/templates dist/server/ && cp -r src/server/public dist/server/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:ts && npm run lint:templates && npm run lint:docker && npm run lint:js",
    "lint:ts": "tsc --noEmit",
    "lint:templates": "find src/server/templates -name '*.ejs' | xargs -I{} ejslint {}",
    "lint:docker": "docker run --rm -v \"$(pwd):/work\" -w /work hadolint/hadolint hadolint Dockerfile",
    "lint:js": "eslint .",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "node-cron": "^4.6.0",
    "podcast": "^2.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ejs-lint": "^2.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
