{
  "name": "narratio",
  "version": "1.0.0",
  "description": "Self-hosted RSS-to-podcast with AI-generated audio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/server/templates dist/server/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:templates": "find src/server/templates -name '*.ejs' | xargs -I{} ejslint {}",
    "lint:docker": "docker run --rm -v \"$(pwd):/work\" -w /work hadolint/hadolint hadolint Dockerfile"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.0.20",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "ejs": "^5.0.2",
    "express": "^4.19.2",
    "html-to-text": "^9.0.5",
    "node-cron": "^3.0.3",
    "podcast": "^2.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ejs-lint": "^2.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
