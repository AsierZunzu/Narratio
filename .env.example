# ── Required ──────────────────────────────────────────────────────────────────
RSS_URL=https://example.com/feed.xml

# ── Worker ────────────────────────────────────────────────────────────────────
# Cron expression — leave unset to run once and exit
POLL_INTERVAL=0 * * * *

# TTS / Piper (set automatically in Docker Compose; override for local dev)
PIPER_HOST=localhost
PIPER_PORT=10200
TTS_TIMEOUT=300
TTS_MAX_RETRIES=3
RSS_FETCH_TIMEOUT=30000

# Storage quotas (leave unset for no limit)
MAX_AUDIO_FILES=
MAX_AUDIO_SIZE_MB=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Public URL used in audio enclosure links — must be reachable by podcast clients
BASE_URL=http://localhost:3000

PODCAST_TITLE=Narratio
PODCAST_DESCRIPTION=
PODCAST_AUTHOR=Narratio Worker
PODCAST_LANGUAGE=en
PODCAST_ITUNES_OWNER_EMAIL=owner@example.com
PODCAST_ITUNES_CATEGORY=Technology

UNAVAILABLE_MESSAGE=This content is no longer available on the server.
TTS_FAILED_MESSAGE=This podcast episode could not be generated due to a text-to-speech error.
