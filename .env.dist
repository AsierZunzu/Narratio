# ── Worker ────────────────────────────────────────────────────────────────────
# Optional — URL used to seed the initial feed on first DB creation.
RSS_URL=https://example.com/feed.xml

# Cron expression — leave unset to run once and exit
POLL_INTERVAL=0 * * * *

# TTS / Piper (set automatically in Docker Compose; override for local dev)
PIPER_HOST=localhost
PIPER_PORT=10200
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_ES=es_ES-sharvard-medium
TTS_TIMEOUT=300
TTS_MAX_RETRIES=3
RSS_FETCH_TIMEOUT=30000

# Storage quota for the default feed on initial seed (leave unset for unlimited).
# Per-feed quotas can be edited afterwards from the dashboard.
MAX_AUDIO_FILES=

# Set to "true" to wipe DB and audio on startup, then continue normally.
FORCE_RESET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# BASE_URL=https://podcast.example.com

UNAVAILABLE_MESSAGE=This content is no longer available on the server.
TTS_FAILED_MESSAGE=This podcast episode could not be generated due to a text-to-speech error.

# Set any truthy value to enable debug logging
DEBUG=
