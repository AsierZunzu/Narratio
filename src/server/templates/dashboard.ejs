<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Narratio Dashboard</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f1117; color: #e2e8f0; font-size: 14px; }
    a { color: #60a5fa; text-decoration: none; }
    a:hover { text-decoration: underline; }

    header { padding: 16px 24px; border-bottom: 1px solid #1e2535; display: flex; align-items: center; gap: 16px; }
    header h1 { font-size: 18px; font-weight: 600; letter-spacing: 0.02em; }
    .main-nav { display: flex; gap: 4px; margin-left: auto; }
    .nav-btn { background: none; border: 1px solid #252d3f; border-radius: 6px; color: #94a3b8; cursor: pointer; font-size: 13px; padding: 5px 14px; font-family: inherit; }
    .nav-btn:hover { border-color: #3b4a6b; color: #e2e8f0; }
    .nav-btn.active { background: #1e3a5f; border-color: #2563eb; color: #93c5fd; }

    .summary { display: flex; gap: 12px; padding: 16px 24px; flex-wrap: wrap; }
    .stat { background: #1a1f2e; border: 1px solid #252d3f; border-radius: 8px; padding: 10px 16px; min-width: 90px; text-align: center; }
    .stat-value { font-size: 22px; font-weight: 700; }
    .stat-label { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }

    .tabs { display: flex; gap: 4px; padding: 0 24px 12px; flex-wrap: wrap; }
    .tab { background: none; border: 1px solid #252d3f; border-radius: 6px; color: #94a3b8; cursor: pointer; font-size: 13px; padding: 5px 12px; }
    .tab:hover { border-color: #3b4a6b; color: #e2e8f0; }
    .tab.active { background: #1e3a5f; border-color: #2563eb; color: #93c5fd; }
    .tab-count { background: #1e2535; border-radius: 10px; font-size: 11px; padding: 1px 6px; margin-left: 4px; }

    .table-wrap { overflow-x: auto; padding: 0 24px 32px; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #475569; padding: 8px 10px; border-bottom: 1px solid #1e2535; }
    th[data-col] { cursor: pointer; user-select: none; white-space: nowrap; }
    th[data-col]:hover { color: #94a3b8; }
    th[data-col]::after { content: ' ↕'; color: #334155; font-size: 10px; }
    th[data-col].sort-asc::after { content: ' ↑'; color: #60a5fa; }
    th[data-col].sort-desc::after { content: ' ↓'; color: #60a5fa; }
    td { padding: 9px 10px; border-bottom: 1px solid #151a28; vertical-align: middle; }
    tr:hover td { background: #141926; }
    .empty { color: #475569; padding: 24px; text-align: center; }

    .col-title { max-width: 340px; word-break: break-word; }
    .col-feed { white-space: nowrap; font-size: 12px; }
    .col-feed a { color: #60a5fa; }
    .col-words { white-space: nowrap; color: #64748b; font-variant-numeric: tabular-nums; }
    .col-tts-time { white-space: nowrap; color: #64748b; font-variant-numeric: tabular-nums; }
    .col-retries { white-space: nowrap; color: #94a3b8; }
    .col-error { max-width: 200px; }
    .error-msg { color: #f87171; font-size: 12px; cursor: help; }

    .badge { border-radius: 4px; font-size: 11px; font-weight: 600; padding: 2px 7px; text-transform: uppercase; letter-spacing: 0.06em; }
    .badge-pending    { background: #334155; color: #94a3b8; }
    .badge-converting { background: #1e3a5f; color: #93c5fd; animation: pulse 1.4s ease-in-out infinite; }
    .badge-done       { background: #14532d; color: #86efac; }
    .badge-failed     { background: #450a0a; color: #fca5a5; }
    .badge-purged     { background: #422006; color: #fdba74; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }

    .btn { border: none; border-radius: 5px; cursor: pointer; font-size: 12px; padding: 4px 10px; font-family: inherit; text-decoration: none; display: inline-block; }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-link   { background: #1e2535; color: #94a3b8; }
    .btn-link:hover   { background: #252d3f; color: #e2e8f0; text-decoration: none; }
    .btn-retry  { background: #1e3a5f; color: #93c5fd; }
    .btn-retry:hover  { background: #1d4ed8; }
    .btn-purge  { background: #422006; color: #fdba74; }
    .btn-purge:hover  { background: #c2410c; }
    .btn-delete { background: #450a0a; color: #fca5a5; }
    .btn-delete:hover { background: #991b1b; }
    .btn-audio  { background: #14532d; color: #86efac; }
    .btn-audio:hover  { background: #166534; }
    .btn-regen   { background: #1e3a2f; color: #86efac; }
    .btn-regen:hover { background: #15803d; }
    .btn-primary { background: #1d4ed8; color: #bfdbfe; }
    .btn-primary:hover { background: #1e40af; }
    .btn-edit { background: #1e2535; color: #94a3b8; }
    .btn-edit:hover { background: #334155; color: #e2e8f0; }

    #toast { position: fixed; bottom: 24px; right: 24px; background: #1e293b; border: 1px solid #334155; border-radius: 8px; color: #e2e8f0; font-size: 13px; padding: 10px 16px; opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 100; }
    #toast.show { opacity: 1; }
    #toast.error { border-color: #7f1d1d; color: #fca5a5; }

    .btn-view-content { background: none; border: none; cursor: pointer; color: inherit; font: inherit; text-align: left; padding: 0; width: 100%; }
    .btn-view-content:hover a, .btn-view-content:hover { color: #93c5fd; }

    #content-modal, #feed-modal, #tts-modal { display: none; position: fixed; inset: 0; z-index: 200; }
    #content-modal.open, #feed-modal.open, #tts-modal.open { display: flex; align-items: flex-end; justify-content: center; }
    #content-backdrop, .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); }
    #content-panel { position: relative; background: #1a1f2e; border: 1px solid #252d3f; border-radius: 12px 12px 0 0; width: 100%; max-width: 860px; max-height: 70vh; display: flex; flex-direction: column; }
    #content-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid #252d3f; gap: 12px; }
    #content-panel-title { font-size: 14px; font-weight: 600; color: #e2e8f0; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #content-panel-close, .modal-close { background: none; border: none; color: #64748b; cursor: pointer; font-size: 18px; line-height: 1; padding: 2px 6px; border-radius: 4px; }
    #content-panel-close:hover, .modal-close:hover { color: #e2e8f0; background: #252d3f; }
    #content-panel-body { overflow-y: auto; padding: 20px; flex: 1; }
    #content-panel-body pre { white-space: pre-wrap; word-break: break-word; font-family: system-ui, sans-serif; font-size: 14px; line-height: 1.7; color: #cbd5e1; }

    .modal-panel { position: relative; background: #1a1f2e; border: 1px solid #252d3f; border-radius: 12px 12px 0 0; width: 100%; max-width: 680px; max-height: 85vh; display: flex; flex-direction: column; }
    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid #252d3f; }
    .modal-header span { font-size: 15px; font-weight: 600; }
    .modal-body { overflow-y: auto; padding: 20px; flex: 1; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-grid .full { grid-column: 1 / -1; }
    .form-field { display: flex; flex-direction: column; gap: 4px; }
    .form-field label { font-size: 12px; color: #94a3b8; font-weight: 500; }
    .form-field input, .form-field textarea, .form-field select { background: #0f1117; border: 1px solid #252d3f; border-radius: 6px; color: #e2e8f0; font-family: inherit; font-size: 13px; padding: 7px 10px; width: 100%; }
    .form-field input:focus, .form-field textarea:focus, .form-field select:focus { border-color: #2563eb; outline: none; }
    .form-field textarea { min-height: 60px; resize: vertical; }
    .form-field .hint { font-size: 11px; color: #475569; }
    .form-field .hint a, .form-field .hint span { color: #60a5fa; word-break: break-all; }
    .form-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; padding-top: 16px; border-top: 1px solid #1e2535; }
    details.advanced { border: 1px solid #1e2535; border-radius: 8px; padding: 12px 14px; margin-top: 4px; }
    details.advanced summary { cursor: pointer; font-size: 12px; color: #64748b; font-weight: 500; user-select: none; }
    details.advanced[open] summary { color: #94a3b8; margin-bottom: 14px; }

    .feeds-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px 12px; }
    .feeds-header h2 { font-size: 15px; font-weight: 600; }
    .feed-url { font-size: 12px; color: #60a5fa; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .quota-cell { font-size: 12px; color: #64748b; }
    .btn-warning { background: #422006; color: #fdba74; }
    .btn-warning:hover { background: #c2410c; }
  </style>
</head>
<body>
  <header>
    <h1>Narratio</h1>
    <div class="main-nav">
      <button class="nav-btn active" id="nav-articles">Articles</button>
      <button class="nav-btn" id="nav-feeds">Feeds <span class="tab-count"><%= feeds.length %></span></button>
      <button class="nav-btn" id="nav-tts">TTS Services <span class="tab-count"><%= ttsServices.length %></span></button>
    </div>
  </header>

  <!-- ── Articles View ──────────────────────────────────────────────────────── -->
  <div id="articles-view">
    <div class="summary">
      <div class="stat"><div class="stat-value"><%= counts.all %></div><div class="stat-label">Total</div></div>
      <div class="stat"><div class="stat-value" style="color:#94a3b8"><%= counts.pending %></div><div class="stat-label">Pending</div></div>
      <div class="stat"><div class="stat-value" style="color:#93c5fd"><%= counts.converting %></div><div class="stat-label">Converting</div></div>
      <div class="stat"><div class="stat-value" style="color:#86efac"><%= counts.done %></div><div class="stat-label">Done</div></div>
      <div class="stat"><div class="stat-value" style="color:#fca5a5"><%= counts.failed %></div><div class="stat-label">Failed</div></div>
      <div class="stat"><div class="stat-value" style="color:#fdba74"><%= counts.purged %></div><div class="stat-label">Purged</div></div>
    </div>

    <div class="tabs">
      <% ['all', 'pending', 'converting', 'done', 'failed', 'purged'].forEach(function(s) { %>
        <button class="tab" data-filter="<%= s %>"><%= s === 'all' ? 'All' : STATUS_LABELS[s] %> <span class="tab-count"><%= counts[s] %></span></button>
      <% }); %>
    </div>

    <div class="table-wrap">
      <table id="articles-table">
        <thead>
          <tr>
            <th data-col="title">Title</th>
            <th>Feed</th>
            <th data-col="status">Status</th>
            <th data-col="date">Date</th>
            <th data-col="words">Words</th>
            <th data-col="tts-time">TTS Time</th>
            <th data-col="retries">Retries</th>
            <th>Error</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="articles-body">
          <% if (articles.length === 0) { %>
            <tr><td colspan="9" class="empty">No articles yet. The worker will populate this table after the first RSS poll.</td></tr>
          <% } else { %>
            <% articles.forEach(function(a) { %>
              <% var articleFeed = a.feed_id ? feedMap[a.feed_id] : null; %>
              <tr data-guid="<%= a.guid %>" data-status="<%= a.status %>" data-feed-id="<%= a.feed_id || '' %>" data-content="<%= a.content || '' %>">
                <td class="col-title" data-val="<%= a.title.toLowerCase() %>">
                  <% if (a.content) { %>
                    <button class="btn-view-content" data-guid="<%= a.guid %>" title="View content"><%= a.title %></button>
                  <% } else { %>
                    <%= a.title %>
                  <% } %>
                </td>
                <td class="col-feed">
                  <% if (articleFeed) { %>
                    <a href="<%= baseUrl %>/rss/<%= articleFeed.slug %>" target="_blank" rel="noopener" title="<%= articleFeed.rss_url %>"><%= articleFeed.name %></a>
                  <% } else { %>
                    <span style="color:#475569">—</span>
                  <% } %>
                </td>
                <td class="col-status" data-val="<%= a.status %>"><span class="badge badge-<%= a.status %>"><%= STATUS_LABELS[a.status] || a.status %></span></td>
                <td class="col-date" data-val="<%= a.pub_date || '' %>"><%= formatDate(a.pub_date) %></td>
                <td class="col-words" data-val="<%= wordCountNum(a.content) %>"><%= wordCount(a.content) %></td>
                <td class="col-tts-time" data-val="<%= a.tts_elapsed_ms != null ? a.tts_elapsed_ms : -1 %>"><%= formatElapsed(a.tts_elapsed_ms) %></td>
                <td class="col-retries" data-val="<%= a.tts_retries != null ? a.tts_retries : -1 %>"><%= a.status === 'failed' ? a.tts_retries + '×' : '—' %></td>
                <td class="col-error">
                  <% if (a.status === 'failed' && a.error) { %>
                    <span class="error-msg" title="<%= a.error %>"><%= a.error.length > 60 ? a.error.slice(0, 60) + '…' : a.error %></span>
                  <% } %>
                </td>
                <td class="col-actions">
                  <% if (a.link) { %>
                    <a class="btn btn-link" href="<%= a.link %>" target="_blank" rel="noopener">↗ Article</a>
                  <% } %>
                  <% if (a.status === 'failed') { %>
                    <button class="btn btn-retry" data-action="retry" data-guid="<%= a.guid %>">Retry</button>
                  <% } %>
                  <% if (a.status === 'done') { %>
                    <button class="btn btn-purge" data-action="purge" data-guid="<%= a.guid %>">Purge</button>
                  <% } %>
                  <% if (a.status === 'done' || a.status === 'purged') { %>
                    <button class="btn btn-regen" data-action="regenerate" data-guid="<%= a.guid %>">Regenerate</button>
                  <% } %>
                  <% if (a.status === 'done' && a.audio_file) { %>
                    <a class="btn btn-audio" href="<%= baseUrl %>/audio/<%= encodeURIComponent(a.audio_file) %>">▶ Audio</a>
                  <% } %>
                  <button class="btn btn-delete" data-action="delete" data-guid="<%= a.guid %>">Delete</button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── Feeds View ─────────────────────────────────────────────────────────── -->
  <div id="feeds-view" style="display:none">
    <div class="feeds-header">
      <h2>RSS Feeds</h2>
      <button class="btn btn-primary" id="add-feed-btn">+ Add Feed</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Podcast URL</th>
            <th>RSS Source</th>
            <th>TTS Service</th>
            <th>Quotas</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="feeds-body">
          <% if (feeds.length === 0) { %>
            <tr><td colspan="6" class="empty">No feeds configured. Click "+ Add Feed" to get started.</td></tr>
          <% } else { %>
            <% feeds.forEach(function(f) { %>
              <% var tts = ttsServices.find(function(s) { return s.id === f.tts_service_id; }); %>
              <tr data-feed-id="<%= f.id %>">
                <td><strong><%= f.name %></strong><br><small style="color:#64748b"><%= f.title %></small></td>
                <td><a class="feed-url" href="<%= baseUrl %>/rss/<%= f.slug %>" target="_blank"><%= baseUrl %>/rss/<%= f.slug %></a></td>
                <td><small class="feed-url"><%= f.rss_url %></small></td>
                <td><small><%= tts ? tts.name + ' (' + tts.host + ':' + tts.port + ')' : 'Unknown' %></small></td>
                <td class="quota-cell">
                  <%= f.max_audio_files ? f.max_audio_files + ' files' : '∞ files' %><br>
                  <%= f.max_audio_size_mb ? f.max_audio_size_mb + ' MB' : '∞ MB' %>
                </td>
                <td>
                  <button class="btn btn-edit" data-feed-edit="<%= f.id %>">Edit</button>
                  <button class="btn btn-delete" data-feed-delete="<%= f.id %>">Delete</button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── TTS Services View ─────────────────────────────────────────────────── -->
  <div id="tts-view" style="display:none">
    <div class="feeds-header">
      <h2>TTS Services</h2>
      <button class="btn btn-primary" id="add-tts-btn">+ Add TTS Service</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Host</th>
            <th>Port</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tts-body">
          <% if (ttsServices.length === 0) { %>
            <tr><td colspan="4" class="empty">No TTS services configured. Click "+ Add TTS Service" to get started.</td></tr>
          <% } else { %>
            <% ttsServices.forEach(function(svc) { %>
              <tr data-tts-id="<%= svc.id %>">
                <td><strong><%= svc.name %></strong></td>
                <td><%= svc.host %></td>
                <td><%= svc.port %></td>
                <td>
                  <button class="btn btn-edit" data-tts-edit="<%= svc.id %>">Edit</button>
                  <button class="btn btn-delete" data-tts-delete="<%= svc.id %>">Delete</button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── TTS Modal ─────────────────────────────────────────────────────────── -->
  <div id="tts-modal">
    <div class="modal-backdrop" id="tts-modal-backdrop"></div>
    <div class="modal-panel" style="max-width:480px">
      <div class="modal-header">
        <span id="tts-modal-title">Add TTS Service</span>
        <button class="modal-close" id="tts-modal-close">✕</button>
      </div>
      <div class="modal-body">
        <form id="tts-form" autocomplete="off">
          <input type="hidden" id="tts-id" value="">
          <div class="form-grid">
            <div class="form-field full">
              <label for="t-name">Name <span style="color:#ef4444">*</span></label>
              <input id="t-name" name="name" required placeholder="Default Piper">
            </div>
            <div class="form-field">
              <label for="t-host">Host <span style="color:#ef4444">*</span></label>
              <input id="t-host" name="host" required placeholder="localhost">
            </div>
            <div class="form-field">
              <label for="t-port">Port <span style="color:#ef4444">*</span></label>
              <input id="t-port" name="port" type="number" required min="1" max="65535" placeholder="10200">
            </div>
          </div>
          <div class="form-actions" style="justify-content:space-between;align-items:center">
            <div style="display:flex;align-items:center;gap:8px">
              <button type="button" class="btn btn-link" id="tts-test-btn">Test Connection</button>
              <span id="tts-test-result" style="font-size:12px"></span>
            </div>
            <div style="display:flex;gap:10px">
              <button type="button" class="btn btn-link" id="tts-form-cancel">Cancel</button>
              <button type="submit" class="btn btn-primary" id="tts-form-submit">Save</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- ── Feed Modal ─────────────────────────────────────────────────────────── -->
  <div id="feed-modal">
    <div class="modal-backdrop" id="feed-modal-backdrop"></div>
    <div class="modal-panel">
      <div class="modal-header">
        <span id="feed-modal-title">Add Feed</span>
        <button class="modal-close" id="feed-modal-close">✕</button>
      </div>
      <div class="modal-body">
        <form id="feed-form" autocomplete="off">
          <input type="hidden" id="feed-id" value="">
          <div class="form-grid">
            <div class="form-field">
              <label for="f-name">Name <span style="color:#ef4444">*</span></label>
              <input id="f-name" name="name" required placeholder="My Tech Podcast">
            </div>
            <div class="form-field">
              <label for="f-tts">TTS Service <span style="color:#ef4444">*</span></label>
              <select id="f-tts" name="tts_service_id" required>
                <% ttsServices.forEach(function(svc) { %>
                  <option value="<%= svc.id %>"><%= svc.name %> (<%= svc.host %>:<%= svc.port %>)</option>
                <% }); %>
                <% if (ttsServices.length === 0) { %>
                  <option value="" disabled>No TTS services configured</option>
                <% } %>
              </select>
            </div>
            <div class="form-field full">
              <label for="f-rss-url">RSS URL <span style="color:#ef4444">*</span></label>
              <input id="f-rss-url" name="rss_url" type="url" required placeholder="https://example.com/feed.xml">
            </div>
            <div class="form-field">
              <label for="f-slug">Slug <span style="color:#ef4444">*</span></label>
              <input id="f-slug" name="slug" required pattern="[a-z0-9-]+" placeholder="my-tech-podcast">
              <span class="hint">Podcast URL: <span id="f-slug-preview"></span></span>
            </div>
            <div class="form-field">
              <label for="f-title">Podcast Title <span style="color:#ef4444">*</span></label>
              <input id="f-title" name="title" required placeholder="My Tech Podcast">
            </div>
            <div class="form-field full">
              <label for="f-desc">Description</label>
              <textarea id="f-desc" name="description" placeholder="A brief description of this podcast"></textarea>
            </div>
            <div class="form-field">
              <label for="f-author">Author</label>
              <input id="f-author" name="author" placeholder="Narratio Worker">
            </div>
            <div class="form-field">
              <label for="f-lang">Language</label>
              <input id="f-lang" name="language" placeholder="en">
            </div>
            <div class="form-field">
              <label for="f-max-files">Max Audio Files</label>
              <input id="f-max-files" name="max_audio_files" type="number" min="1" placeholder="Unlimited">
              <span class="hint">Leave empty for no limit</span>
            </div>
            <div class="form-field">
              <label for="f-max-size">Max Audio Size (MB)</label>
              <input id="f-max-size" name="max_audio_size_mb" type="number" min="1" placeholder="Unlimited">
              <span class="hint">Leave empty for no limit</span>
            </div>
          </div>

          <details class="advanced" style="margin-top:16px">
            <summary>Advanced (iTunes metadata &amp; messages)</summary>
            <div class="form-grid" style="margin-top:4px">
              <div class="form-field">
                <label for="f-itunes-author">iTunes Author</label>
                <input id="f-itunes-author" name="itunes_author">
              </div>
              <div class="form-field">
                <label for="f-itunes-category">iTunes Category</label>
                <input id="f-itunes-category" name="itunes_category" placeholder="Technology">
              </div>
              <div class="form-field">
                <label for="f-itunes-owner-name">iTunes Owner Name</label>
                <input id="f-itunes-owner-name" name="itunes_owner_name">
              </div>
              <div class="form-field">
                <label for="f-itunes-owner-email">iTunes Owner Email</label>
                <input id="f-itunes-owner-email" name="itunes_owner_email" type="email">
              </div>
              <div class="form-field full">
                <label for="f-itunes-summary">iTunes Summary</label>
                <textarea id="f-itunes-summary" name="itunes_summary"></textarea>
              </div>
              <div class="form-field full">
                <label for="f-unavailable-msg">Unavailable Episode Message</label>
                <textarea id="f-unavailable-msg" name="unavailable_message" placeholder="This content is no longer available on the server."></textarea>
              </div>
              <div class="form-field full">
                <label for="f-failed-msg">TTS Failed Message</label>
                <textarea id="f-failed-msg" name="tts_failed_message" placeholder="This podcast episode could not be generated due to a text-to-speech error."></textarea>
              </div>
            </div>
          </details>

          <div class="form-actions">
            <button type="button" class="btn btn-link" id="feed-form-cancel">Cancel</button>
            <button type="submit" class="btn btn-primary" id="feed-form-submit">Save Feed</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="toast"></div>

  <div id="content-modal">
    <div id="content-backdrop"></div>
    <div id="content-panel">
      <div id="content-panel-header">
        <span id="content-panel-title"></span>
        <button id="content-panel-close" title="Close">✕</button>
      </div>
      <div id="content-panel-body"><pre id="content-panel-text"></pre></div>
    </div>
  </div>

  <script>
    const BASE_URL = '<%= baseUrl %>';
    const STATUS_LABELS = { pending: 'Pending', converting: 'Converting', done: 'Done', failed: 'Failed', purged: 'Purged' };
    const FEED_MAP = <%- JSON.stringify(feedMap) %>;

    function escAttr(s) {
      return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function clientFormatDate(d) {
      if (!d) return '—';
      try { return new Date(d).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); }
      catch { return String(d); }
    }
    function clientFormatElapsed(ms) {
      if (ms == null) return '—';
      return ms < 1000 ? ms + 'ms' : (ms / 1000).toFixed(1) + 's';
    }
    function clientWordCount(content) {
      if (!content) return '—';
      const text = content.replace(/<[^>]+>/g, ' ').replace(/&[a-z]+;/gi, ' ').trim();
      if (!text) return '—';
      return text.split(/\s+/).filter(Boolean).length + ' w';
    }
    function clientWordCountNum(content) {
      if (!content) return -1;
      const text = content.replace(/<[^>]+>/g, ' ').replace(/&[a-z]+;/gi, ' ').trim();
      if (!text) return -1;
      return text.split(/\s+/).filter(Boolean).length;
    }

    const toast = document.getElementById('toast');
    function showToast(msg, isError) {
      toast.textContent = msg;
      toast.className = 'show' + (isError ? ' error' : '');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => { toast.className = ''; }, 3000);
    }

    // ── View switching ────────────────────────────────────────────────────────
    const navArticles = document.getElementById('nav-articles');
    const navFeeds = document.getElementById('nav-feeds');
    const navTts = document.getElementById('nav-tts');
    const articlesView = document.getElementById('articles-view');
    const feedsView = document.getElementById('feeds-view');
    const ttsView = document.getElementById('tts-view');

    function showView(view) {
      articlesView.style.display = 'none';
      feedsView.style.display = 'none';
      ttsView.style.display = 'none';
      navArticles.classList.remove('active');
      navFeeds.classList.remove('active');
      navTts.classList.remove('active');
      if (view === 'feeds') {
        feedsView.style.display = '';
        navFeeds.classList.add('active');
        refreshFeedsTable();
      } else if (view === 'tts') {
        ttsView.style.display = '';
        navTts.classList.add('active');
        refreshTtsTable();
      } else {
        articlesView.style.display = '';
        navArticles.classList.add('active');
      }
    }

    navArticles.addEventListener('click', () => showView('articles'));
    navFeeds.addEventListener('click', () => showView('feeds'));
    navTts.addEventListener('click', () => showView('tts'));

    // ── TTS Services table ────────────────────────────────────────────────────
    async function refreshTtsTable() {
      try {
        const res = await fetch('/api/tts-services');
        if (!res.ok) return;
        const services = await res.json();
        const tbody = document.getElementById('tts-body');
        navTts.querySelector('.tab-count').textContent = services.length;
        if (services.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="empty">No TTS services configured. Click "+ Add TTS Service" to get started.</td></tr>';
          return;
        }
        tbody.innerHTML = services.map(s =>
          `<tr data-tts-id="${escAttr(s.id)}">
            <td><strong>${escHtml(s.name)}</strong></td>
            <td>${escHtml(s.host)}</td>
            <td>${escHtml(String(s.port))}</td>
            <td>
              <button class="btn btn-edit" data-tts-edit="${escAttr(s.id)}">Edit</button>
              <button class="btn btn-delete" data-tts-delete="${escAttr(s.id)}">Delete</button>
            </td>
          </tr>`
        ).join('');
      } catch { /* silent */ }
    }

    // ── TTS modal ─────────────────────────────────────────────────────────────
    const ttsModal = document.getElementById('tts-modal');
    const ttsForm = document.getElementById('tts-form');
    const ttsIdInput = document.getElementById('tts-id');

    function openTtsModal(svc) {
      ttsForm.reset();
      const testResultEl = document.getElementById('tts-test-result');
      if (testResultEl) testResultEl.textContent = '';
      if (svc) {
        document.getElementById('tts-modal-title').textContent = 'Edit TTS Service';
        ttsIdInput.value = svc.id;
        ttsForm.elements['name'].value = svc.name || '';
        ttsForm.elements['host'].value = svc.host || '';
        ttsForm.elements['port'].value = svc.port || '';
      } else {
        document.getElementById('tts-modal-title').textContent = 'Add TTS Service';
        ttsIdInput.value = '';
      }
      ttsModal.classList.add('open');
    }

    function closeTtsModal() { ttsModal.classList.remove('open'); }

    document.getElementById('tts-modal-close').addEventListener('click', closeTtsModal);
    document.getElementById('tts-form-cancel').addEventListener('click', closeTtsModal);
    document.getElementById('tts-modal-backdrop').addEventListener('click', closeTtsModal);
    document.getElementById('add-tts-btn').addEventListener('click', () => openTtsModal(null));

    // ── TTS connection test ────────────────────────────────────────────────────
    document.getElementById('tts-test-btn').addEventListener('click', async () => {
      const host = ttsForm.elements['host'].value.trim();
      const port = ttsForm.elements['port'].value.trim();
      const resultEl = document.getElementById('tts-test-result');
      const testBtn = document.getElementById('tts-test-btn');

      if (!host || !port) {
        resultEl.style.color = '#f87171';
        resultEl.textContent = 'Enter host and port first';
        return;
      }

      testBtn.disabled = true;
      resultEl.style.color = '#94a3b8';
      resultEl.textContent = 'Testing…';

      try {
        const res = await fetch('/api/tts-services/test-connection', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ host, port: Number(port) }),
        });
        const data = await res.json();
        if (data.ok) {
          resultEl.style.color = '#86efac';
          resultEl.textContent = '✓ ' + data.message;
        } else {
          resultEl.style.color = '#f87171';
          resultEl.textContent = '✗ ' + data.message;
        }
      } catch {
        resultEl.style.color = '#f87171';
        resultEl.textContent = '✗ Network error';
      } finally {
        testBtn.disabled = false;
      }
    });

    ttsForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = ttsIdInput.value;
      const data = Object.fromEntries(new FormData(ttsForm).entries());
      data['port'] = Number(data['port']);
      const submitBtn = document.getElementById('tts-form-submit');
      submitBtn.disabled = true;
      try {
        const url = id ? '/api/tts-services/' + encodeURIComponent(id) : '/api/tts-services';
        const method = id ? 'PUT' : 'POST';
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (res.ok) {
          showToast(id ? 'TTS service updated' : 'TTS service created', false);
          closeTtsModal();
          refreshTtsTable();
        } else {
          showToast(await res.text(), true);
        }
      } catch {
        showToast('Network error', true);
      } finally {
        submitBtn.disabled = false;
      }
    });

    document.getElementById('tts-body').addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-tts-edit]');
      const deleteBtn = e.target.closest('[data-tts-delete]');

      if (editBtn) {
        const id = editBtn.dataset.ttsEdit;
        try {
          const res = await fetch('/api/tts-services');
          const services = await res.json();
          const svc = services.find(s => String(s.id) === String(id));
          if (svc) openTtsModal(svc);
        } catch { showToast('Failed to load TTS service data', true); }
        return;
      }

      if (deleteBtn) {
        const id = deleteBtn.dataset.ttsDelete;
        if (!confirm('Delete this TTS service? This cannot be undone.')) return;
        deleteBtn.disabled = true;
        try {
          const res = await fetch('/api/tts-services/' + encodeURIComponent(id), { method: 'DELETE' });
          if (res.ok) {
            showToast('TTS service deleted', false);
            refreshTtsTable();
          } else {
            showToast(await res.text(), true);
            deleteBtn.disabled = false;
          }
        } catch {
          showToast('Network error', true);
          deleteBtn.disabled = false;
        }
      }
    });

    // ── Feeds table ───────────────────────────────────────────────────────────
    async function refreshFeedsTable() {
      try {
        const res = await fetch('/api/feeds');
        if (!res.ok) return;
        const feeds = await res.json();
        const ttsRes = await fetch('/api/tts-services');
        const ttsServices = ttsRes.ok ? await ttsRes.json() : [];
        const ttsMap = Object.fromEntries(ttsServices.map(s => [s.id, s]));

        const tbody = document.getElementById('feeds-body');
        if (feeds.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="empty">No feeds configured. Click "+ Add Feed" to get started.</td></tr>';
          return;
        }
        tbody.innerHTML = feeds.map(f => {
          const tts = ttsMap[f.tts_service_id];
          const ttsLabel = tts ? escHtml(tts.name + ' (' + tts.host + ':' + tts.port + ')') : 'Unknown';
          const podcastUrl = BASE_URL + '/rss/' + escAttr(f.slug);
          const files = f.max_audio_files ? f.max_audio_files + ' files' : '∞ files';
          const size = f.max_audio_size_mb ? f.max_audio_size_mb + ' MB' : '∞ MB';
          return `<tr data-feed-id="${escAttr(f.id)}">
            <td><strong>${escHtml(f.name)}</strong><br><small style="color:#64748b">${escHtml(f.title)}</small></td>
            <td><a class="feed-url" href="${podcastUrl}" target="_blank">${escHtml(podcastUrl)}</a></td>
            <td><small class="feed-url">${escHtml(f.rss_url)}</small></td>
            <td><small>${ttsLabel}</small></td>
            <td class="quota-cell">${escHtml(files)}<br>${escHtml(size)}</td>
            <td>
              <button class="btn btn-edit" data-feed-edit="${escAttr(f.id)}">Edit</button>
              <button class="btn btn-delete" data-feed-delete="${escAttr(f.id)}">Delete</button>
            </td>
          </tr>`;
        }).join('');

        // update nav badge
        navFeeds.querySelector('.tab-count').textContent = feeds.length;
      } catch { /* silent */ }
    }

    // ── Feed modal ────────────────────────────────────────────────────────────
    const feedModal = document.getElementById('feed-modal');
    const feedModalTitle = document.getElementById('feed-modal-title');
    const feedForm = document.getElementById('feed-form');
    const feedIdInput = document.getElementById('feed-id');
    const slugInput = document.getElementById('f-slug');
    const slugPreview = document.getElementById('f-slug-preview');

    slugInput.addEventListener('input', () => {
      slugPreview.textContent = BASE_URL + '/rss/' + (slugInput.value || '…');
    });

    async function refreshTtsDropdown(selectedId) {
      try {
        const res = await fetch('/api/tts-services');
        if (!res.ok) return;
        const services = await res.json();
        const sel = document.getElementById('f-tts');
        sel.innerHTML = services.length === 0
          ? '<option value="" disabled>No TTS services configured</option>'
          : services.map(s => `<option value="${escAttr(s.id)}"${String(s.id) === String(selectedId) ? ' selected' : ''}>${escHtml(s.name)} (${escHtml(s.host)}:${escHtml(String(s.port))})</option>`).join('');
      } catch { /* silent */ }
    }

    function openFeedModal(feed) {
      feedForm.reset();
      refreshTtsDropdown(feed ? feed.tts_service_id : null);
      if (feed) {
        feedModalTitle.textContent = 'Edit Feed';
        feedIdInput.value = feed.id;
        feedForm.elements['name'].value = feed.name || '';
        feedForm.elements['rss_url'].value = feed.rss_url || '';
        feedForm.elements['slug'].value = feed.slug || '';
        feedForm.elements['title'].value = feed.title || '';
        feedForm.elements['description'].value = feed.description || '';
        feedForm.elements['author'].value = feed.author || '';
        feedForm.elements['language'].value = feed.language || '';
        feedForm.elements['tts_service_id'].value = feed.tts_service_id || '';
        feedForm.elements['max_audio_files'].value = feed.max_audio_files || '';
        feedForm.elements['max_audio_size_mb'].value = feed.max_audio_size_mb || '';
        feedForm.elements['itunes_author'].value = feed.itunes_author || '';
        feedForm.elements['itunes_category'].value = feed.itunes_category || '';
        feedForm.elements['itunes_owner_name'].value = feed.itunes_owner_name || '';
        feedForm.elements['itunes_owner_email'].value = feed.itunes_owner_email || '';
        feedForm.elements['itunes_summary'].value = feed.itunes_summary || '';
        feedForm.elements['unavailable_message'].value = feed.unavailable_message || '';
        feedForm.elements['tts_failed_message'].value = feed.tts_failed_message || '';
        slugPreview.textContent = BASE_URL + '/rss/' + feed.slug;
      } else {
        feedModalTitle.textContent = 'Add Feed';
        feedIdInput.value = '';
        slugPreview.textContent = BASE_URL + '/rss/…';
      }
      feedModal.classList.add('open');
    }

    function closeFeedModal() {
      feedModal.classList.remove('open');
    }

    document.getElementById('feed-modal-close').addEventListener('click', closeFeedModal);
    document.getElementById('feed-form-cancel').addEventListener('click', closeFeedModal);
    document.getElementById('feed-modal-backdrop').addEventListener('click', closeFeedModal);
    document.getElementById('add-feed-btn').addEventListener('click', () => openFeedModal(null));

    feedForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = feedIdInput.value;
      const data = Object.fromEntries(new FormData(feedForm).entries());

      // Coerce numeric fields
      if (data['max_audio_files'] === '') delete data['max_audio_files'];
      else if (data['max_audio_files']) data['max_audio_files'] = Number(data['max_audio_files']);
      if (data['max_audio_size_mb'] === '') delete data['max_audio_size_mb'];
      else if (data['max_audio_size_mb']) data['max_audio_size_mb'] = Number(data['max_audio_size_mb']);
      data['tts_service_id'] = Number(data['tts_service_id']);

      const submitBtn = document.getElementById('feed-form-submit');
      submitBtn.disabled = true;
      try {
        const url = id ? '/api/feeds/' + encodeURIComponent(id) : '/api/feeds';
        const method = id ? 'PUT' : 'POST';
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (res.ok) {
          showToast(id ? 'Feed updated' : 'Feed created', false);
          closeFeedModal();
          refreshFeedsTable();
        } else {
          showToast(await res.text(), true);
        }
      } catch {
        showToast('Network error', true);
      } finally {
        submitBtn.disabled = false;
      }
    });

    document.getElementById('feeds-body').addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-feed-edit]');
      const deleteBtn = e.target.closest('[data-feed-delete]');

      if (editBtn) {
        const id = editBtn.dataset.feedEdit;
        try {
          const res = await fetch('/api/feeds');
          const feeds = await res.json();
          const feed = feeds.find(f => String(f.id) === String(id));
          if (feed) openFeedModal(feed);
        } catch { showToast('Failed to load feed data', true); }
        return;
      }

      if (deleteBtn) {
        const id = deleteBtn.dataset.feedDelete;
        if (!confirm('Delete this feed?\n\nAll articles belonging to this feed AND their audio files will be permanently removed. This cannot be undone.')) return;
        deleteBtn.disabled = true;
        try {
          const res = await fetch('/api/feeds/' + encodeURIComponent(id), { method: 'DELETE' });
          if (res.ok) {
            showToast('Feed deleted', false);
            refreshFeedsTable();
          } else {
            showToast(await res.text(), true);
            deleteBtn.disabled = false;
          }
        } catch {
          showToast('Network error', true);
          deleteBtn.disabled = false;
        }
      }
    });

    // ── Articles: counts & filter ─────────────────────────────────────────────
    function recalcCounts() {
      const rows = [...document.querySelectorAll('#articles-body tr[data-status]')];
      const counts = { all: rows.length, pending: 0, converting: 0, done: 0, failed: 0, purged: 0 };
      rows.forEach(r => { const s = r.dataset.status; if (s in counts) counts[s]++; });
      document.querySelectorAll('.stat').forEach(stat => {
        const label = stat.querySelector('.stat-label').textContent.toLowerCase();
        if (label in counts) stat.querySelector('.stat-value').textContent = counts[label];
      });
      document.querySelectorAll('.tab').forEach(tab => {
        const f = tab.dataset.filter;
        tab.querySelector('.tab-count').textContent = f === 'all' ? counts.all : (counts[f] ?? 0);
      });
    }

    function applyActiveFilter(row) {
      const filter = document.querySelector('.tab.active')?.dataset.filter;
      row.style.display = (!filter || filter === 'all' || row.dataset.status === filter) ? '' : 'none';
    }

    function applyAction(action, row, btn) {
      if (action === 'delete') {
        row.remove();
        recalcCounts();
        return;
      }
      const newStatus = action === 'retry' || action === 'regenerate' ? 'pending' : 'purged';
      row.dataset.status = newStatus;
      row.querySelector('.col-status').innerHTML = `<span class="badge badge-${newStatus}">${STATUS_LABELS[newStatus]}</span>`;
      if (action === 'retry') {
        btn.remove();
        row.querySelector('.col-error').innerHTML = '';
        row.querySelector('.col-tts-time').textContent = '—';
        row.querySelector('.col-retries').textContent = '—';
      } else if (action === 'regenerate') {
        row.querySelector('[data-action="regenerate"]')?.remove();
        row.querySelector('[data-action="purge"]')?.remove();
        row.querySelector('.btn-audio')?.remove();
        row.querySelector('.col-error').innerHTML = '';
        row.querySelector('.col-tts-time').textContent = '—';
        row.querySelector('.col-retries').textContent = '—';
      } else {
        row.querySelector('[data-action="purge"]')?.remove();
        row.querySelector('.btn-audio')?.remove();
      }
      applyActiveFilter(row);
      recalcCounts();
    }

    function applyFilter() {
      const filter = document.querySelector('.tab.active')?.dataset.filter ?? 'all';
      document.querySelectorAll('#articles-body tr[data-status]').forEach(row => {
        row.style.display = (filter === 'all' || row.dataset.status === filter) ? '' : 'none';
      });
      sortTable();
    }

    function buildFeedCell(feedId) {
      const feed = feedId ? FEED_MAP[feedId] : null;
      if (!feed) return '<span style="color:#475569">—</span>';
      return `<a href="${BASE_URL}/rss/${escAttr(feed.slug)}" target="_blank" rel="noopener" title="${escAttr(feed.rss_url)}">${escHtml(feed.name)}</a>`;
    }

    // ── Column sorting ────────────────────────────────────────────────────────
    let sortCol = null;
    let sortDir = 'asc';

    const COL_CLASS = {
      title: 'col-title', status: 'col-status', date: 'col-date',
      words: 'col-words', 'tts-time': 'col-tts-time', retries: 'col-retries',
    };
    const COL_TYPE = {
      title: 'str', status: 'str', date: 'str',
      words: 'num', 'tts-time': 'num', retries: 'num',
    };

    function sortTable() {
      if (!sortCol) return;
      const tbody = document.getElementById('articles-body');
      const rows = [...tbody.querySelectorAll('tr[data-guid]')];
      const type = COL_TYPE[sortCol];
      const cls = COL_CLASS[sortCol];
      rows.sort((a, b) => {
        const tdA = a.querySelector('.' + cls);
        const tdB = b.querySelector('.' + cls);
        let va = tdA ? (tdA.dataset.val || '') : '';
        let vb = tdB ? (tdB.dataset.val || '') : '';
        if (type === 'num') {
          va = parseFloat(va);
          vb = parseFloat(vb);
          if (isNaN(va)) va = -Infinity;
          if (isNaN(vb)) vb = -Infinity;
        }
        if (va < vb) return sortDir === 'asc' ? -1 : 1;
        if (va > vb) return sortDir === 'asc' ? 1 : -1;
        return 0;
      });
      rows.forEach(r => tbody.appendChild(r));
    }

    document.querySelectorAll('#articles-table th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (sortCol === col) {
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        } else {
          sortCol = col;
          sortDir = 'asc';
        }
        document.querySelectorAll('#articles-table th').forEach(t => t.classList.remove('sort-asc', 'sort-desc'));
        th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
        sortTable();
      });
    });

    function buildRow(a) {
      const label = STATUS_LABELS[a.status] || a.status;
      const content = a.content || '';

      const titleCell = content
        ? `<button class="btn-view-content" data-guid="${escAttr(a.guid)}" title="View content">${escAttr(a.title)}</button>`
        : escAttr(a.title);

      let errorHtml = '';
      if (a.status === 'failed' && a.error) {
        const msg = a.error.length > 60 ? a.error.slice(0, 60) + '…' : a.error;
        errorHtml = `<span class="error-msg" title="${escAttr(a.error)}">${escAttr(msg)}</span>`;
      }

      let actions = '';
      if (a.link) actions += `<a class="btn btn-link" href="${escAttr(a.link)}" target="_blank" rel="noopener">↗ Article</a> `;
      if (a.status === 'failed') actions += `<button class="btn btn-retry" data-action="retry" data-guid="${escAttr(a.guid)}">Retry</button> `;
      if (a.status === 'done') actions += `<button class="btn btn-purge" data-action="purge" data-guid="${escAttr(a.guid)}">Purge</button> `;
      if (a.status === 'done' || a.status === 'purged') actions += `<button class="btn btn-regen" data-action="regenerate" data-guid="${escAttr(a.guid)}">Regenerate</button> `;
      if (a.status === 'done' && a.audio_file) actions += `<a class="btn btn-audio" href="${BASE_URL}/audio/${encodeURIComponent(a.audio_file)}">▶ Audio</a> `;
      actions += `<button class="btn btn-delete" data-action="delete" data-guid="${escAttr(a.guid)}">Delete</button>`;

      return `<tr data-guid="${escAttr(a.guid)}" data-status="${escAttr(a.status)}" data-feed-id="${escAttr(a.feed_id ?? '')}" data-content="${escAttr(content)}">
        <td class="col-title" data-val="${escAttr((a.title || '').toLowerCase())}">${titleCell}</td>
        <td class="col-feed">${buildFeedCell(a.feed_id)}</td>
        <td class="col-status" data-val="${escAttr(a.status)}"><span class="badge badge-${escAttr(a.status)}">${escAttr(label)}</span></td>
        <td class="col-date" data-val="${escAttr(a.pub_date || '')}">${clientFormatDate(a.pub_date)}</td>
        <td class="col-words" data-val="${clientWordCountNum(a.content)}">${clientWordCount(a.content)}</td>
        <td class="col-tts-time" data-val="${a.tts_elapsed_ms != null ? a.tts_elapsed_ms : -1}">${clientFormatElapsed(a.tts_elapsed_ms)}</td>
        <td class="col-retries" data-val="${a.tts_retries != null ? a.tts_retries : -1}">${a.status === 'failed' ? escAttr(String(a.tts_retries)) + '×' : '—'}</td>
        <td class="col-error">${errorHtml}</td>
        <td class="col-actions">${actions}</td>
      </tr>`;
    }

    function reconcile(apiArticles) {
      const tbody = document.getElementById('articles-body');
      const savedY = window.scrollY;

      const apiMap = new Map(apiArticles.map(a => [a.guid, a]));

      const domRows = new Map();
      tbody.querySelectorAll('tr[data-guid]').forEach(tr => domRows.set(tr.dataset.guid, tr));

      if (apiArticles.length > 0) {
        tbody.querySelector('tr:not([data-guid])')?.remove();
      }

      let changed = false;

      for (const article of apiArticles) {
        const existing = domRows.get(article.guid);
        if (existing) {
          domRows.delete(article.guid);
          if (existing.querySelector('[data-action]:disabled')) continue;
          if (existing.dataset.status === article.status) continue;

          existing.dataset.status = article.status;
          existing.dataset.content = article.content || '';
          existing.querySelector('.col-status').innerHTML =
            `<span class="badge badge-${escAttr(article.status)}">${STATUS_LABELS[article.status] || article.status}</span>`;
          existing.querySelector('.col-words').textContent = clientWordCount(article.content);
          existing.querySelector('.col-tts-time').textContent = clientFormatElapsed(article.tts_elapsed_ms);
          existing.querySelector('.col-retries').textContent = article.status === 'failed' ? article.tts_retries + '×' : '—';

          let errorHtml = '';
          if (article.status === 'failed' && article.error) {
            const msg = article.error.length > 60 ? article.error.slice(0, 60) + '…' : article.error;
            errorHtml = `<span class="error-msg" title="${escAttr(article.error)}">${escAttr(msg)}</span>`;
          }
          existing.querySelector('.col-error').innerHTML = errorHtml;

          let actions = '';
          if (article.link) actions += `<a class="btn btn-link" href="${escAttr(article.link)}" target="_blank" rel="noopener">↗ Article</a> `;
          if (article.status === 'failed') actions += `<button class="btn btn-retry" data-action="retry" data-guid="${escAttr(article.guid)}">Retry</button> `;
          if (article.status === 'done') actions += `<button class="btn btn-purge" data-action="purge" data-guid="${escAttr(article.guid)}">Purge</button> `;
          if (article.status === 'done' || article.status === 'purged') actions += `<button class="btn btn-regen" data-action="regenerate" data-guid="${escAttr(article.guid)}">Regenerate</button> `;
          if (article.status === 'done' && article.audio_file) actions += `<a class="btn btn-audio" href="${BASE_URL}/audio/${encodeURIComponent(article.audio_file)}">▶ Audio</a> `;
          actions += `<button class="btn btn-delete" data-action="delete" data-guid="${escAttr(article.guid)}">Delete</button>`;
          existing.querySelector('.col-actions').innerHTML = actions;
          changed = true;
        } else {
          const temp = document.createElement('tbody');
          temp.innerHTML = buildRow(article);
          const newTr = temp.firstElementChild;
          const allRows = [...tbody.querySelectorAll('tr[data-guid]')];
          const newDate = article.pub_date || article.created_at || '';
          const insertBefore = allRows.find(row => {
            const rowArt = apiMap.get(row.dataset.guid);
            const rowDate = rowArt ? (rowArt.pub_date || rowArt.created_at || '') : '';
            return newDate > rowDate;
          }) ?? null;
          tbody.insertBefore(newTr, insertBefore);
          changed = true;
        }
      }

      for (const [, tr] of domRows) {
        if (!tr.querySelector('[data-action]:disabled')) { tr.remove(); changed = true; }
      }

      if (tbody.querySelectorAll('tr[data-guid]').length === 0 && !tbody.querySelector('.empty')) {
        tbody.innerHTML = '<tr><td colspan="9" class="empty">No articles yet. The worker will populate this table after the first RSS poll.</td></tr>';
      }

      if (changed) { recalcCounts(); applyFilter(); sortTable(); }
      window.scrollTo(0, savedY);
    }

    // Filter tabs
    const tabs = document.querySelectorAll('.tab');
    tabs[0].classList.add('active');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        applyFilter();
      });
    });

    // Content panel
    const modal = document.getElementById('content-modal');
    const backdrop = document.getElementById('content-backdrop');
    const panelTitle = document.getElementById('content-panel-title');
    const panelText = document.getElementById('content-panel-text');
    const closeBtn = document.getElementById('content-panel-close');

    function openContentPanel(title, content) {
      panelTitle.textContent = title;
      panelText.textContent = content;
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeContentPanel() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    closeBtn.addEventListener('click', closeContentPanel);
    backdrop.addEventListener('click', closeContentPanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContentPanel();
        closeFeedModal();
        closeTtsModal();
      }
    });

    document.getElementById('articles-body').addEventListener('click', (e) => {
      const viewBtn = e.target.closest('.btn-view-content');
      if (!viewBtn) return;
      const row = viewBtn.closest('tr[data-guid]');
      if (!row) return;
      openContentPanel(viewBtn.textContent.trim(), row.dataset.content || '');
    });

    // Action buttons
    document.getElementById('articles-body').addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const { action, guid } = btn.dataset;
      if (action === 'delete' && !confirm('Delete this article permanently?')) return;
      if (action === 'regenerate' && !confirm('Regenerate audio for this article? The current audio file will be deleted and TTS will run again on the next worker poll.')) return;

      const row = btn.closest('tr[data-guid]');
      btn.disabled = true;
      try {
        const url = '/api/articles/' + encodeURIComponent(guid) + (action === 'delete' ? '' : '/' + action);
        const res = await fetch(url, { method: action === 'delete' ? 'DELETE' : 'POST' });
        if (!res.ok) {
          showToast('Error: ' + await res.text(), true);
          btn.disabled = false;
        } else {
          const toastMsg = action === 'regenerate' ? 'Regenerate queued' : action.charAt(0).toUpperCase() + action.slice(1) + ' successful';
          showToast(toastMsg, false);
          applyAction(action, row, btn);
        }
      } catch {
        showToast('Network error', true);
        btn.disabled = false;
      }
    });

    setInterval(async () => {
      try {
        const res = await fetch('/api/articles');
        if (res.ok) reconcile(await res.json());
      } catch { /* silent */ }
    }, 5000);
  </script>
</body>
</html>
